ACTION!="add", GOTO="sillage_live_end"
SUBSYSTEM!="block", GOTO="sillage_live_end"
KERNEL=="loop*|ram*|zram*|sr*", GOTO="sillage_live_end"
IMPORT{cmdline}="boot"
ENV{boot}!="casper", GOTO="sillage_live_end"
IMPORT{cmdline}="sillage_protect"
ENV{sillage_protect}!="1", GOTO="sillage_live_end"
ENV{UDISKS_IGNORE}="1", RUN+="/usr/sbin/blockdev --setro $devnode"
LABEL="sillage_live_end"
