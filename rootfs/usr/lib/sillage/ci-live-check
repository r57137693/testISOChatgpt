#!/bin/sh
set -eu

modprobe qemu_fw_cfg 2>/dev/null || exit 0
marker=/sys/firmware/qemu_fw_cfg/by_name/opt/org.sillage.ci/raw
[ -r "$marker" ] && [ "$(tr -d '\000\n' < "$marker")" = 1 ] || exit 0
exec > /dev/ttyS0 2>&1
trap 'echo SILLAGE_CI_FAILED' EXIT

set -- /sys/firmware/efi/efivars/SecureBoot-*
[ -e "$1" ]
[ "$(od -An -j4 -N1 -tu1 "$1" | tr -d ' ')" = 1 ]
echo 'UEFI Secure Boot actif'
test "$(blockdev --getro /dev/vda)" = 1
test "$(blockdev --getro /dev/vda1)" = 1
if findmnt --source /dev/vda1 >/dev/null; then
    echo 'La partition témoin ne doit pas être montée.'
    exit 1
fi
echo 'Disque témoin et partition en lecture seule, sans montage'
test -b /dev/zram0
if /usr/lib/sillage/calamares-visible; then
    echo 'Calamares est accessible en mode Essayer.'
    exit 1
fi
for attempt in $(seq 1 90); do
    if pgrep -x xfce4-session >/dev/null && pgrep -x xfce4-panel >/dev/null; then
        trap - EXIT
        echo 'SILLAGE_LIVE_OK'
        exit 0
    fi
    sleep 2
done
echo 'Le bureau Xfce ne s’est pas ouvert.'
journalctl -b -u lightdm --no-pager -n 40
exit 1
