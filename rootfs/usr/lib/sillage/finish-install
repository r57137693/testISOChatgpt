#!/bin/sh
set -eu

test -s /etc/fstab
if ! grep -q '^/swapfile[[:space:]]' /etc/fstab; then
    install -m 0600 /dev/null /swapfile
    if ! fallocate -l 1G /swapfile; then
        dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none
    fi
    mkswap /swapfile
    printf '/swapfile none swap sw,pri=10 0 0\n' >> /etc/fstab
fi

# L’installation utilise le noyau installé avec les modules NVIDIA signés.
# En retirant Casper, le nouvel initramfs démarre depuis la partition racine.
DEBIAN_FRONTEND=noninteractive apt-get -y purge casper calamares
update-initramfs -u -k all
