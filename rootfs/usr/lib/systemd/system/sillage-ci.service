[Unit]
Description=Vérification du démarrage live de Sillage en CI
ConditionVirtualization=vm
ConditionKernelCommandLine=sillage_protect=1
After=display-manager.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/sillage/ci-live-check
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
